#!/usr/bin/make -f
# -*- makefile -*-
# Debian rules for the Ananas monorepo. Builds with CMake and produces two
# binary packages from the single source tree: ananas and libqdataschema.

# Uncomment this to turn on verbose mode.
#export DH_VERBOSE=1

export QTDIR=/usr/lib/x86_64-linux-gnu/qt6

configure: configure-stamp
configure-stamp:
	dh_testdir
	cmake -S . -B cmake-build \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib
	touch configure-stamp

build: build-arch
build-arch: build-stamp

build-stamp: configure-stamp
	dh_testdir
	cmake --build cmake-build -j$(shell nproc)
	# Translations (.qm). Non-fatal if lrelease is unavailable.
	-lrelease translations/*.ts
	touch $@

clean:
	dh_testdir
	dh_testroot
	rm -f build-stamp configure-stamp
	rm -rf cmake-build
	dh_clean

install: build
	dh_testdir
	dh_testroot
	dh_prep
	dh_installdirs

	# Install the whole tree into a staging directory.
	rm -rf $(CURDIR)/debian/tmp
	DESTDIR=$(CURDIR)/debian/tmp cmake --install cmake-build

	# ----- ananas -----
	mkdir -p $(CURDIR)/debian/ananas/usr/bin
	mkdir -p $(CURDIR)/debian/ananas/usr/lib/ananas/designer
	mkdir -p $(CURDIR)/debian/ananas/usr/share/ananas/translations
	mkdir -p $(CURDIR)/debian/ananas/usr/share/applications
	mkdir -p $(CURDIR)/debian/ananas/usr/share/pixmaps

	cp -f $(CURDIR)/debian/tmp/usr/bin/ananas \
	      $(CURDIR)/debian/tmp/usr/bin/ananas-administrator \
	      $(CURDIR)/debian/tmp/usr/bin/ananas-designer \
	      $(CURDIR)/debian/ananas/usr/bin/
	cp -df $(CURDIR)/debian/tmp/usr/lib/libananas.so* $(CURDIR)/debian/ananas/usr/lib/
	cp -df $(CURDIR)/debian/tmp/usr/lib/libqtscriptedit.so* $(CURDIR)/debian/ananas/usr/lib/
	cp -df $(CURDIR)/debian/tmp/usr/lib/ananas/*.so $(CURDIR)/debian/ananas/usr/lib/ananas/
	cp -df $(CURDIR)/debian/tmp/usr/lib/ananas/designer/* $(CURDIR)/debian/ananas/usr/lib/ananas/designer/
	mkdir -p $(CURDIR)/debian/ananas/usr/include
	cp -a $(CURDIR)/debian/tmp/usr/include/ananas $(CURDIR)/debian/ananas/usr/include/ 2>/dev/null || true

	# translations
	cp -f ./translations/*.qm $(CURDIR)/debian/ananas/usr/share/ananas/translations/ 2>/dev/null || true

	# desktop entries and icons
	cp -f ./build/menus/kde/ananas.desktop ./build/menus/kde/ananas-designer.desktop \
	      $(CURDIR)/debian/ananas/usr/share/applications/
	cp -f ./build/icons/*.png $(CURDIR)/debian/ananas/usr/share/pixmaps/

	# inventory schemes: metadata, report templates, rc files and registry
	mkdir -p $(CURDIR)/debian/ananas/usr/share/ananas/applications/inventory
	mkdir -p $(CURDIR)/debian/ananas/etc/ananas
	mkdir -p $(CURDIR)/debian/ananas/etc/xdg/ananas
	cp -f ./applications/inventory/inventory.cfg \
	      ./applications/inventory/inventory-demo.cfg \
	      ./applications/inventory/inventory-demo-data.sql \
	      $(CURDIR)/debian/ananas/usr/share/ananas/applications/inventory/
	cp -f ./applications/inventory/templ_* $(CURDIR)/debian/ananas/usr/share/ananas/applications/inventory/
	cp -f ./applications/ananas-cfg.dtd $(CURDIR)/debian/ananas/usr/share/ananas/applications/inventory/
	cp -f ./build/ubuntu/inventory.rc ./build/ubuntu/inventory-demo.rc $(CURDIR)/debian/ananas/etc/ananas/
	cp -f ./build/ubuntu/ananas.conf $(CURDIR)/debian/ananas/etc/xdg/ananas/

	# ----- libqdataschema -----
	mkdir -p $(CURDIR)/debian/libqdataschema/usr/bin
	mkdir -p $(CURDIR)/debian/libqdataschema/usr/lib
	cp -f $(CURDIR)/debian/tmp/usr/bin/qdsadm $(CURDIR)/debian/libqdataschema/usr/bin/
	cp -df $(CURDIR)/debian/tmp/usr/lib/libqdataschema.so* $(CURDIR)/debian/libqdataschema/usr/lib/
	mkdir -p $(CURDIR)/debian/libqdataschema/usr/include
	cp -a $(CURDIR)/debian/tmp/usr/include/qdataschema $(CURDIR)/debian/libqdataschema/usr/include/ 2>/dev/null || true

	rm -rf $(CURDIR)/debian/tmp

binary-indep: build install

binary-arch: build install
	dh_testdir
	dh_testroot
	dh_installchangelogs
	dh_installdocs
	dh_installexamples
	dh_installman
	dh_link
	dh_strip
	dh_compress
	dh_fixperms
	dh_makeshlibs
	dh_installdeb
	dh_shlibdeps
	dh_gencontrol
	dh_md5sums
	dh_builddeb

binary: binary-indep binary-arch
.PHONY: build clean binary-indep binary-arch binary install configure
