#!/usr/bin/make -f
# -*- makefile -*-
# Sample debian/rules that uses debhelper.
# This file was originally written by Joey Hess and Craig Small.
# As a special exception, when this file is copied by dh-make into a
# dh-make output file, you may use that output file without restriction.
# This special exception was added by Craig Small in version 0.37 of dh-make.

# Uncomment this to turn on verbose mode.
#export DH_VERBOSE=1

export QTDIR=/usr/lib/x86_64-linux-gnu/qt5

CFLAGS = -Wall -g

ifneq (,$(findstring noopt,$(DEB_BUILD_OPTIONS)))
	CFLAGS += -O0
else
	CFLAGS += -O2
endif

configure: configure-stamp
configure-stamp:
	dh_testdir
	# Add here commands to configure the package.
	
	touch configure-stamp

build: build-arch
build-arch: build-stamp

build-stamp: configure-stamp 
	dh_testdir

	# Add here commands to compile the package.

	$(MAKE) -e QT_VER=5
	touch $@

clean:
	dh_testdir
	dh_testroot
	rm -f build-stamp configure-stamp

	# Add here commands to clean up after the build process.
#	-$(MAKE) clean

	dh_clean 

install: build
	dh_testdir
	dh_testroot
	dh_prep
	dh_installdirs

	# Install the Qt5 build artifacts. Headers go to both the Qt5 module
	# header dir ($$[QT_INSTALL_HEADERS]) and $$[QT_INSTALL_DATA]/include,
	# which are the paths ananas.pri adds to INCLUDEPATH.
	mkdir -p $(CURDIR)/debian/libqdataschema/usr/lib
	mkdir -p $(CURDIR)/debian/libqdataschema/usr/bin
	mkdir -p $(CURDIR)/debian/libqdataschema/usr/include/x86_64-linux-gnu/qt5/qdataschema
	mkdir -p $(CURDIR)/debian/libqdataschema/usr/share/qt5/include/qdataschema

	cp -df ./lib/* $(CURDIR)/debian/libqdataschema/usr/lib/
	cp -df ./bin/* $(CURDIR)/debian/libqdataschema/usr/bin/
	cp -f ./src/lib/*.h $(CURDIR)/debian/libqdataschema/usr/include/x86_64-linux-gnu/qt5/qdataschema/
	cp -f ./src/lib/*.h $(CURDIR)/debian/libqdataschema/usr/share/qt5/include/qdataschema/

# Build architecture-independent files here.
binary-indep: build install
# We have nothing to do by default.

# Build architecture-dependent files here.
binary-arch: build install
	dh_testdir
	dh_testroot
	dh_installchangelogs 
	dh_installdocs
	dh_installexamples
#	dh_install
#	dh_installmenu
#	dh_installdebconf	
#	dh_installlogrotate
#	dh_installemacsen
#	dh_installpam
#	dh_installmime
#	dh_python
#	dh_installinit
#	dh_installcron
#	dh_installinfo
	dh_installman
	dh_link
	dh_strip
	dh_compress
	dh_fixperms
#	dh_perl
	dh_makeshlibs
	dh_installdeb
	dh_shlibdeps
	dh_gencontrol
	dh_md5sums
	dh_builddeb

binary: binary-indep binary-arch
.PHONY: build clean binary-indep binary-arch binary install configure
