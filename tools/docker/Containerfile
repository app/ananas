FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# Qt6 toolchain (CMake only) + Debian packaging tools. Ubuntu 24.04 ships
# Qt 6.4 with QtQml (QJSEngine), QtDesigner and the Designer components.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    devscripts \
    debhelper \
    dh-make \
    fakeroot \
    qt6-base-dev \
    qt6-base-dev-tools \
    qt6-tools-dev \
    qt6-tools-dev-tools \
    qt6-declarative-dev \
    qt6-l10n-tools \
    libqt6sql6-sqlite \
    libqt6sql6-mysql \
    libqt6sql6-psql \
    libmysqlclient-dev \
    libxkbcommon-dev \
    wget \
    unzip \
    git \
    xvfb \
    ccache \
    && rm -rf /var/lib/apt/lists/*

# The packaging rules invoke `lrelease` by name; qt6-l10n-tools installs it
# under /usr/lib/qt6/bin.
RUN ln -sf /usr/lib/qt6/bin/lrelease /usr/local/bin/lrelease && lrelease -version

# ccache in front of gcc/g++: speeds up repeated (including clean) builds.
ENV PATH=/usr/lib/ccache:$PATH
ENV CCACHE_MAXSIZE=5G
ENV CCACHE_COMPRESS=1

WORKDIR /workspace
